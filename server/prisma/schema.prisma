generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id                       Int                  @id @default(autoincrement())
  email                    String               @unique
  passwordHash             String
  roleId                   Int
  isActive                 Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  role                     Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  alumniProfile            AlumniProfile?
  createdJobs              Job[]                @relation("JobCreator")
  jobApplications          JobApplication[]     @relation("Applicant")
  createdEvents            Event[]              @relation("EventCreator")
  eventRegistrations         EventRegistration[]
  sentMentorshipRequests     MentorshipRequest[]   @relation("MentorshipStudent")
  receivedMentorshipRequests MentorshipRequest[]   @relation("MentorshipMentor")
  createdCampaigns           DonationCampaign[]    @relation("CampaignCreator")
  donations                  DonationTransaction[] @relation("Donor")
  successStories             SuccessStory[]        @relation("StoryAuthor")
}

model AlumniProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  fullName        String
  graduationYear  Int?
  department      String?
  currentJobTitle String?
  currentCompany  String?
  bio             String?
  linkedinUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model Job {
  id                  Int              @id @default(autoincrement())
  title               String
  description         String
  company             String
  location            String?
  employmentType      String
  experienceLevel     String?
  salaryMin           Int?
  salaryMax           Int?
  applicationDeadline DateTime?
  isActive            Boolean          @default(true)
  createdById         Int
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdBy           User             @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  applications        JobApplication[]

  @@index([createdById])
  @@index([isActive])
}

model JobApplication {
  id          Int      @id @default(autoincrement())
  jobId       Int
  applicantId Int
  coverLetter String?
  resumeUrl   String?
  status      String   @default("PENDING")
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant   User     @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([status])
}

model Event {
  id                   Int                 @id @default(autoincrement())
  title                String
  description          String
  location             String?
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  capacity             Int?
  isActive             Boolean             @default(true)
  createdById          Int
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  registrations        EventRegistration[]

  @@index([createdById])
  @@index([startDate])
  @@index([isActive])
}

model EventRegistration {
  id           Int      @id @default(autoincrement())
  eventId      Int
  userId       Int
  status       String   @default("REGISTERED")
  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model MentorshipRequest {
  id        Int      @id @default(autoincrement())
  studentId Int
  mentorId  Int
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User     @relation("MentorshipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor    User     @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([mentorId])
  @@index([status])
}

model DonationCampaign {
  id           Int                   @id @default(autoincrement())
  title        String
  description  String
  targetAmount Decimal               @db.Decimal(14, 2)
  currency     String                @default("INR")
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean               @default(true)
  createdById  Int
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdBy    User                  @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  transactions DonationTransaction[]

  @@index([createdById])
  @@index([isActive])
}

model DonationTransaction {
  id                Int              @id @default(autoincrement())
  campaignId        Int
  donorId           Int
  amount            Decimal          @db.Decimal(14, 2)
  currency          String           @default("INR")
  status            String           @default("PENDING")
  paymentProvider   String?
  providerOrderId   String?
  providerPaymentId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  campaign          DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  donor             User             @relation("Donor", fields: [donorId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([donorId])
  @@index([status])
  @@index([createdAt])
}

model SuccessStory {
  id          String    @id @default(uuid())
  title       String
  content     String
  imageUrl    String?
  authorId    Int
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([isPublished])
  @@index([createdAt])
}

